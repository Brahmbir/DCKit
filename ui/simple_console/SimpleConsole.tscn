[sub_resource type="Shader" id="Shader_6pdhr"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, filter_linear;

//
// Overall effect
//
uniform float effect_strength : hint_range(0.0, 1.0) = 0.65;

//
// Horizontal scanlines
//
uniform float scanline_size = 4.0;
uniform float scanline_strength : hint_range(0.0, 1.0) = 0.16;

//
// Vertical phosphor structure
//
uniform float phosphor_size = 12.0;
uniform float phosphor_strength : hint_range(0.0, 1.0) = 0.055;

//
// RGB displacement
//
uniform float chromatic_shift = 0.45;

//
// Fine noise
//
uniform float noise_strength : hint_range(0.0, 0.1) = 0.008;


// ------------------------------------------------------------
// Small procedural noise
// ------------------------------------------------------------

float hash(vec2 p) {
    return fract(
        sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123
    );
}


// ------------------------------------------------------------
// Fragment
// ------------------------------------------------------------

void fragment() {

    vec2 uv = SCREEN_UV;

    vec2 pixel = 1.0 / vec2(textureSize(screen_texture, 0));

    // --------------------------------------------------------
    // Chromatic screen sampling
    // --------------------------------------------------------

    float r = texture(
        screen_texture,
        uv + vec2(-chromatic_shift * pixel.x, 0.0)
    ).r;

    float g = texture(
        screen_texture,
        uv
    ).g;

    float b = texture(
        screen_texture,
        uv + vec2(chromatic_shift * pixel.x, 0.0)
    ).b;

    vec3 screen = vec3(r, g, b);


    // --------------------------------------------------------
    // Screen pixel coordinates
    // --------------------------------------------------------

    vec2 p = uv / pixel;


    // --------------------------------------------------------
    // Horizontal scanlines
    // --------------------------------------------------------

    float scan_pos = mod(p.y, scanline_size);

    float scanline =
        smoothstep(
            scanline_size * 0.15,
            scanline_size * 0.50,
            scan_pos
        );

    // Darken alternating horizontal lines.
    float scan_mask =
        1.0 - scanline_strength * (1.0 - scanline);


    // --------------------------------------------------------
    // Vertical phosphor pattern
    // --------------------------------------------------------

    float x = mod(p.x, phosphor_size);

    float phosphor_r =
        smoothstep(0.0, phosphor_size * 0.33, x) *
        (1.0 - smoothstep(
            phosphor_size * 0.33,
            phosphor_size * 0.40,
            x
        ));

    float phosphor_g =
        smoothstep(
            phosphor_size * 0.33,
            phosphor_size * 0.40,
            x
        ) *
        (1.0 - smoothstep(
            phosphor_size * 0.66,
            phosphor_size * 0.73,
            x
        ));

    float phosphor_b =
        smoothstep(
            phosphor_size * 0.66,
            phosphor_size * 0.73,
            x
        );


    // Very subtle RGB modulation.
    vec3 phosphor = vec3(
        phosphor_r,
        phosphor_g,
        phosphor_b
    );


    // --------------------------------------------------------
    // Dark vertical grid
    // --------------------------------------------------------

    float vertical_line =
        smoothstep(
            phosphor_size * 0.90,
            phosphor_size,
            x
        );


    vec3 grid_effect =
        phosphor * phosphor_strength;

    grid_effect -=
        vertical_line * phosphor_strength * 0.45;


    // --------------------------------------------------------
    // Combine
    // --------------------------------------------------------

    vec3 result = screen;

    // Scanlines affect everything, including text.
    result *= scan_mask;

    // Add the extremely subtle RGB phosphor structure.
    result += grid_effect * result;


    // --------------------------------------------------------
    // Fine texture
    // --------------------------------------------------------

    float n = hash(floor(p));

    result +=
        (n - 0.5) *
        noise_strength;


    // --------------------------------------------------------
    // Blend effect
    // --------------------------------------------------------

    result = mix(
        screen,
        result,
        effect_strength
    );


    COLOR = vec4(result, 1.0);
}"

