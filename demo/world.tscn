[sub_resource type="Shader" id="Shader_2ssnh"]
code = "shader_type sky;

uniform sampler2D source_panorama : filter_nearest, source_color, hint_default_black;
uniform float exposure : hint_range(0, 128) = 1.0;

group_uniforms pixelation;
uniform int columns : hint_range(64, 4096) = 1024; // cells around 360° (was 320)
group_uniforms;

group_uniforms clouds;
uniform vec3 cloud_color : source_color = vec3(0.75, 0.78, 0.83);
uniform vec3 cloud_shadow : source_color = vec3(0.38, 0.42, 0.5);
uniform float cloud_opacity : hint_range(0, 1) = 0.9;
uniform float cloud_scale : hint_range(0.5, 12) = 3.0;
uniform float cloud_coverage : hint_range(0, 1) = 0.5;  // higher = more sky covered
uniform float cloud_shade_band : hint_range(0.01, 0.4) = 0.12; // density past edge that turns dark
uniform float wind_speed : hint_range(-1, 1) = 0.02;    // turns per second around the dome
group_uniforms;

group_uniforms rain;
uniform vec3 rain_color : source_color = vec3(0.7, 0.8, 1.0);
uniform float rain_strength : hint_range(0, 1) = 0.6;
uniform float rain_density : hint_range(0, 1) = 0.25;
uniform float rain_speed : hint_range(0, 200) = 40.0;     // rows per second
uniform float streak_length : hint_range(1, 64) = 14.0;   // rows
uniform float streak_period : hint_range(16, 256) = 90.0; // rows between streaks
group_uniforms;

float hash11(float p) {
	p = fract(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return fract(p);
}

float hash13(vec3 p) {
	p = fract(p * 0.1031);
	p += dot(p, p.zyx + 31.32);
	return fract((p.x + p.y) * p.z);
}

float vnoise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(mix(hash13(i), hash13(i + vec3(1, 0, 0)), f.x),
			mix(hash13(i + vec3(0, 1, 0)), hash13(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hash13(i + vec3(0, 0, 1)), hash13(i + vec3(1, 0, 1)), f.x),
			mix(hash13(i + vec3(0, 1, 1)), hash13(i + vec3(1, 1, 1)), f.x), f.y),
		f.z);
}

float fbm(vec3 p) {
	float a = 0.5;
	float s = 0.0;
	for (int i = 0; i < 4; i++) {
		s += a * vnoise(p);
		p = p * 2.03 + vec3(11.7, 3.1, 7.3);
		a *= 0.5;
	}
	return s; // roughly 0..0.94
}

// uv is an equirectangular coordinate; clouds are computed from its direction.
vec3 sky_color(vec2 uv) {
	vec3 col = texture(source_panorama, uv).rgb * exposure;

	float lon = uv.x * TAU;
	float lat = uv.y * PI;
	vec3 dir = vec3(sin(lat) * sin(lon), cos(lat), sin(lat) * cos(lon));

	// Wind = slow yaw rotation of the noise field, so it never distorts.
	float a = TIME * wind_speed * TAU;
	vec3 p = vec3(dir.x * cos(a) - dir.z * sin(a), dir.y, dir.x * sin(a) + dir.z * cos(a));

	float d = fbm(p * cloud_scale);
	// Thin the clouds toward the horizon and hide them below it.
	float edge = (1.0 - cloud_coverage) * 0.94 + (1.0 - smoothstep(0.0, 0.35, dir.y)) * 0.3;
	float body = step(edge, d) * step(0.0, dir.y);
	vec3 ccol = mix(cloud_color, cloud_shadow, step(edge + cloud_shade_band, d));
	return mix(col, ccol, body * cloud_opacity);
}

void sky() {
	if (AT_CUBEMAP_PASS || AT_HALF_RES_PASS) {
		// Clouds still count for ambient light; no pixelation or rain here.
		COLOR = sky_color(SKY_COORDS);
	} else {
		vec2 grid = vec2(float(columns), float(columns) * 0.5);
		vec2 cell = floor(SKY_COORDS * grid);
		vec3 col = sky_color((cell + 0.5) / grid);

		float h = hash11(cell.x);
		float h2 = hash11(cell.x + 17.0);
		if (h2 < rain_density) {
			float speed = rain_speed * mix(0.6, 1.4, h);
			float phase = mod(TIME * speed - cell.y + h * streak_period, streak_period);
			float streak = phase < streak_length ? 1.0 - phase / streak_length : 0.0;
			col = mix(col, rain_color, streak * rain_strength);
		}
		COLOR = col;
	}
}"

